// TOC Initialize the MRF24J
void Mrf24j_begin (uint16_t _myPANID, uint16_t _mySourceAddress)
{
  pinMode(WHAT_CHIP_SELECT, OUTPUT);  // Chip Select pin is defined in WHAT.h
  //pinMode(_pin_reset, OUTPUT);
  //pinMode(_pin_int, INPUT);

  SPI.setBitOrder(MSBFIRST) ;
  SPI.setDataMode(SPI_MODE0);
  SPI.begin();

  Mrf24j_reset();           // Copied from mff24 library to this routine
  Mrf24j_set_pan(_myPANID);  // Copied from mff24 library to this routine
  // This is _our_ address
  Mrf24j_set_SourceAddress(_mySourceAddress);  // Copied from mff24 library to this routine
  //Mrf24j_rx_flush();
  // uncomment if you want to receive any packet on this channel
  Mrf24j_set_promiscuous(true);
  // uncomment if you want to enable PA/LNA external control
  //Mrf24j_set_palna(true);
  // uncomment if you want to buffer all PHY Payload
  //Mrf24j_set_bufferPHY(true);

}
// *************************************************************************

void Mrf24j_reset (void)
{
  // Mrf24j_Write(_address_of_register , _data_value_to_write);
  //Mrf24j_Write(MRF24J_SOFTRST,0x07);

  //Give timeout for chip to reset
  //  Serial.println(micros());
  //double _lastmilli = millis()+200;    // Time out if reset does not finish within 100mS
  //uint16_t _counter = 0;
  //while ((Mrf24j_Read(MRF24J_SOFTRST) & 0x7) != 0) {
  // wait for soft reset to finish
  //   _counter++;
  //if (millis()>_lastmilli) break;
  //}
  //Serial.print("count:");Serial.println(_counter);

  Mrf24j_Write(MRF24J_PACON2, 0x98); // – Initialize FIFOEN = 1 and TXONTS = 0x6.
  Mrf24j_Write(MRF24J_TXPEMISP, 0x95); // – Initialize RFSTBL = 0x9.

  //Mrf24j_Write(MRF24J_RFCTRL0, 0x03); // – Initialize RFOPT = 0x03.
  Mrf24j_Write(MRF24J_RFCTRL1, 0x01); // – Initialize VCOOPT = 0x02.
  Mrf24j_Write(MRF24J_RFCTRL2, 0x80); // – Enable PLL (PLLEN = 1).
  Mrf24j_Write(MRF24J_RFCTRL3, 0x90); // – Initialize TXFIL = 1 and 20MRECVR = 1.
  Mrf24j_Write(MRF24J_RFCTRL7, 0x80); // – Initialize SLPCLKSEL = 0x2 (100 kHz Internal oscillator).
  Mrf24j_Write(MRF24J_RFCTRL8, 0x10); // – Initialize RFVCO = 1.
  Mrf24j_Write(MRF24J_SLPCON1, 0x21); // – Initialize CLKOUTEN = 1 and SLPCLKDIV = 0x01.

  //  Configuration for nonbeacon-enabled devices (see Section 3.8 “Beacon-Enabled and
  //  Nonbeacon-Enabled Networks”):
  Mrf24j_Write(MRF24J_BBREG2, 0xC6); // Set CCA mode to ED

  //Mrf24j_Write(MRF24J_CCAEDTH, 0x60); // – Set CCA ED threshold.
  //Mrf24j_Write(MRF24J_BBREG6, 0x40); // – Set appended RSSI value to RXFIFO.
  //set_interrupts();
  Mrf24j_set_channel(12);
  // max power is by default.. just leave it...
  // Set transmitter power - See “REGISTER 2-62: RF CONTROL 3 REGISTER (ADDRESS: 0x203)”.
  Mrf24j_Write(MRF24J_RFCTL, 0x04); //  – Reset RF state machine.
  Mrf24j_Write(MRF24J_RFCTL, 0x00); // part 2
  delay(1); // delay at least 192usec

  Mrf24j_Write(MRF24J_RXFLUSH, 0x61);
  Mrf24j_Write(MRF24J_TRISGPIO, 0b11110001); // ; Set the I/O state of the GPIO pins.
  Mrf24j_Write(MRF24J_GPIO, MRF24J_GPIO_Rx); // ; Set the state of the GPIO pins. (receive mode)
  Mrf24j_Write(MRF24J_TESTMODE, 0b00001111); //; GPIO0, GPIO1 and GPIO2 are configured to control an external PA and/or LNA (*** Manually control GPIO3 to turn on before transmit and off afterward!!!)
  Mrf24j_Write(MRF24J_TRISGPIO, 0b11111111); //; GPIO0, GPIO1 and GPIO2 are configured to control an external PA and/or LNA (*** Manually control GPIO3 to turn on before transmit and off afterward!!!)
  Mrf24j_Write(MRF24J_TESTMODE, 0b00001000); // ; GPIO0, GPIO1 and GPIO2 are configured to control an external PA and/or LNA (*** Manually control GPIO3 to turn on before transmit and off afterward!!!)
  Mrf24j_Write(MRF24J_PACON2, 0b00001000); //, // ; GPIO0, GPIO1 and GPIO2 are configured to control an external PA and/or LNA (*** Manually control GPIO3 to turn on before transmit and off afterward!!!)

  Mrf24j_Write(MRF24J_SADRL, 0xFF);
  Mrf24j_Write(MRF24J_SADRH, 0xFF);
  Mrf24j_Write(MRF24J_PANIDL, 0xFF);
  Mrf24j_Write(MRF24J_PANIDH, 0xFF);
  Mrf24j_Write(MRF24J_EADR0, 0xAA);
  Mrf24j_Write(MRF24J_EADR1, 0xAA);
  Mrf24j_Write(MRF24J_EADR2, 0xAA);
  Mrf24j_Write(MRF24J_EADR3, 0xAA);
  Mrf24j_Write(MRF24J_EADR4, 0xAA);
  Mrf24j_Write(MRF24J_EADR5, 0xAA);
  Mrf24j_Write(MRF24J_EADR6, 0xAA);
  Mrf24j_Write(MRF24J_EADR7, 0xAA);
  Mrf24j_Write(MRF24J_PACON2, 0x98); // ; / * Tx and Rx FIFO output enable signal - via state machine * /
  //Mrf24j_Write(MRF24J_RFCTRL0, 0x03); //; / * RF Optimization * / Phase Locked Loop MUST be enabled to Tx or Rx.
  //Serial.println(Mrf24j_Read(MRF24J_RFCTRL0));
  Mrf24j_Write(MRF24J_RFCTRL1, 0x01); //; / * set optimal VCO current value * /
  Mrf24j_Write(MRF24J_RFCTRL2, 0x80); //; / * RF Optimization * / Phase Locked Loop MUST be enabled to Tx or Rx.
  Mrf24j_Write(MRF24J_RFCTRL3, 0x00); //; Spec sheet recommends this setting
  Mrf24j_Write(MRF24J_RFCTRL6, 0x90); // * program RSSI ADC with 2.5 MHz clock * /
  Mrf24j_Write(MRF24J_RFCTRL7, 0x80); // – Initialize SLPCLKSEL = 0x2 (100 kHz Internal oscillator).
  Mrf24j_Write(MRF24J_RFCTRL8, 0x10); // / * VCO control equals 1 * /
  Mrf24j_Write(MRF24J_TXPEMISP, 0x95);
  //Mrf24j_Write(MRF24J_BBREG2,0xC6); /// * Program CCA mode using RSSI * /
  Mrf24j_Write(MRF24J_BBREG2, 0x80); /// * Program CCA mode using RSSI * /

  Mrf24j_Write(MRF24J_CCAEDTH, 0x60);
  Mrf24j_Write(MRF24J_BBREG6, 0x40); // / * Append RSSI value in RxFIFO * /
  //Mrf24j_Write(MRF24J_CLKINTCR,0x03);
  Mrf24j_Write(MRF24J_RXMCR, 0x01);

  Mrf24j_Write(MRF24J_ACKTMOUT, 0xB9); //  ; Microchip stack does this.  I had not defined this register. ;*** this WAS defined, so ACKTMOUT was set to B9
  Mrf24j_Write(MRF24J_TXPEMISP, 0x95);
  Mrf24j_Write(MRF24J_SLPCON1, 0x01); //;/ * Set sleep clk div = 1 * /
  Mrf24j_Write(MRF24J_SLPACK, 0x5F);  //;/ * System clock (20MHZz) recovery time = 0x5f * /
  Mrf24j_Write(MRF24J_RFCTL, 0x04);
  Mrf24j_Write(MRF24J_RFCTL, 0x00);

  Mrf24j_Write(MRF24J_ORDER, 0xFF);
  delay(2);
  //Serial.println(Mrf24j_Read(MRF24J_BBREG2), HEX);

}
// *************************************************************************
// TOC Get the PAN ID from the MRF24J
uint16_t Mrf24j_get_pan(void)
{
  uint16_t _ret =  Mrf24j_Read(MRF24J_PANIDH) * 0x100; // get the high byte and shift it into the upper byte of the return value
  _ret = _ret + Mrf24j_Read(MRF24J_PANIDL); // add on the low byte.
  return _ret;
}
// *************************************************************************
// TOC Set the PAN ID to the MRF24J
void Mrf24j_set_pan(uint16_t _panid)
{
  Mrf24j_Write(MRF24J_PANIDH, highByte(_panid));
  Mrf24j_Write(MRF24J_PANIDL, lowByte(_panid));
}
// *************************************************************************
// TOC Set the source Address for this application
void   Mrf24j_set_SourceAddress(uint16_t _mySourceAddress)  // Copied from mff24 library to this routine
{
  Mrf24j_Write(MRF24J_SADRH , highByte(_mySourceAddress));
  Mrf24j_Write(MRF24J_SADRL , lowByte(_mySourceAddress));
}

// *************************************************************************
// TOC Get the source Address from this application
uint16_t Mrf24j_get_SourceAddress(void)  // Copied from mff24 library to this routine
{
  return Mrf24j_Read(MRF24J_SADRH) * 0x100 + Mrf24j_Read(MRF24J_SADRL);
}

// *************************************************************************
void Mrf24j_set_promiscuous(boolean _enabled)
{
  if (_enabled)
  {
    Mrf24j_Write(MRF24J_RXMCR, 0x01);
  } else
  {
    Mrf24j_Write(MRF24J_RXMCR, 0x00);
  }
}
// *************************************************************************
// *************************************************************************
// TOC Get the channel for this application

void Mrf24j_set_channel(uint8_t _channel)
{
  Mrf24j_Write(MRF24J_RFCTRL0, (((_channel - 11) << 4) | 0x03));
}
// *************************************************************************

void Mrf24j_set_palna(bool _enabled)
{
  if (_enabled)
  {
    Mrf24j_Write(MRF24J_TESTMODE, 0x07); // Enable PA/LNA on MRF24J40MB module.
  } else
  {
    Mrf24j_Write(MRF24J_TESTMODE, 0x00); // Disable PA/LNA on MRF24J40MB module.
  }
}
// *************************************************************************
// *************************************************************************
// TOC Recieve MRF24J buffer

void WHAT_Buffer_RX(void)
{
  // Read header
  WHAT_Rx_Packet.frame_length = Mrf24j_Read(MRF24J_RxNFrameLength);
  WHAT_Rx_Packet.frame_control = Mrf24j_Read(MRF24J_RxNFrmCntrl) + (Mrf24j_Read(MRF24J_RxNFrmCntrl2) * 0x100);
  WHAT_Rx_Packet.pan_id =  Mrf24j_Read(MRF24J_RxN_PANIDL) + Mrf24j_Read(MRF24J_RxN_PANIDH) * 0x100;
  WHAT_Rx_Packet.destination =  Mrf24j_Read(MRF24J_RxN_DESTL) + Mrf24j_Read(MRF24J_RxN_DESTH) * 0x100;
  WHAT_Rx_Packet.sourceaddress = Mrf24j_Read(MRF24J_RxN_SOURCEL) + Mrf24j_Read(MRF24J_RxN_SOURCEH) * 0x100;
  #ifdef RX_MONITOR
  Serial.println(F("Length\tCONTROL\tRx pan_id\tdestination\tsource"));
  Serial.print(WHAT_Rx_Packet.frame_length,DEC);Serial.print("\t  ");
  Serial.print(WHAT_Rx_Packet.frame_control,HEX);Serial.print("\t  ");
  Serial.print(WHAT_Rx_Packet.pan_id,HEX);Serial.print("\t  ");
  Serial.print(WHAT_Rx_Packet.destination,HEX);Serial.print("\t  ");
  Serial.println(WHAT_Rx_Packet.sourceaddress,HEX);
  #endif
  
  // read the payload
  //Serial.print(F("Adr:0x"));Serial.print(WHAT_ADR_PAYLOADSTART,HEX);Serial.print(F(":"));
  for (uint8_t _i = 0; _i <= WHAT_Rx_Packet.frame_length; _i++)
  {
    WHAT_Rx_Packet.payload[_i] = Mrf24j_Read(WHAT_ADR_PAYLOADSTART + _i);
    #ifdef RX_MONITOR
    //Serial.print(F(", 0x"));Serial.print(Mrf24j_Read(WHAT_ADR_PAYLOADSTART + _i),HEX);
    #endif
  }
    //Serial.println(" ");
  // Extra bytes are added to the FIFO.
  //Serial.print("\nFCS low: ");Serial.print(Mrf24j_Read(WHAT_ADR_RxSTART + WHAT_Rx_Packet.frame_length+1),HEX);
  //Serial.print("\nFCS high: ");Serial.print(Mrf24j_Read(WHAT_ADR_RxSTART + WHAT_Rx_Packet.frame_length+2),HEX);

  WHAT_Rx_Packet.lqi = Mrf24j_Read(WHAT_ADR_RxSTART + WHAT_Rx_Packet.frame_length + 3);
  WHAT_Rx_Packet.rssi = Mrf24j_Read(WHAT_ADR_RxSTART + WHAT_Rx_Packet.frame_length + 4);
  //Serial.print("\nlqi: ");Serial.print(WHAT_Rx_Packet.lqi,HEX);
  //Serial.print("\nrssi: ");Serial.println(WHAT_Rx_Packet.rssi,HEX);
  //Serial.print("\n");
}
// *************************************************************************
// *************************************************************************
// TOC Transmit Message from buffer
void Tx_What_Que(void)  // If more that one message is being send, this will send the next message once the previous message is gone.
{ // Checks to see if a message is waiting to be placed in the transmit queue
    //Serial.print(F("Pend/send "));Serial.print(TxQueue_PendIndex);Serial.println(" / ");Serial.print(TxQueue_SentIndex);

  if(TxQueue_PendIndex != TxQueue_SentIndex)
  {
    if(!(Mrf24j_Read(MRF24J_TXNCON)& MRF24J_TXNTRIG))  // If the transmit bit has cleared...
    {
      // Header length is primarily derermined from the Frame Control, which
      // decides if PANID, SOURCE,and DESTINATION are included in the header.
      TxQueue[TxQueue_SentIndex].frame_length = TxQueue[TxQueue_SentIndex].header_length + TxQueue[TxQueue_SentIndex].payload[0];
      Mrf24j_Write(MRF24J_TxNFrameLength, TxQueue[TxQueue_SentIndex].frame_length);
      Mrf24j_Write(MRF24J_TxNHeadLength, TxQueue[TxQueue_SentIndex].header_length);
      Mrf24j_Write(MRF24J_TxNFrmCntrl, lowByte(TxQueue[TxQueue_SentIndex].frame_control));
      Mrf24j_Write(MRF24J_TxNFrmCntrl2, highByte(TxQueue[TxQueue_SentIndex].frame_control));
      Mrf24j_Write(MRF24J_TxNSeq, TxQueue[TxQueue_SentIndex].sequence_number);
      //Mrf24j_Write(MRF24J_TxNFrmCntrl, 0b01100001);
      //Mrf24j_Write(MRF24J_TxNFrmCntrl2, 0b10001000);
      //Mrf24j_Write(MRF24J_TxNSeq, 1);
      Mrf24j_Write(MRF24J_TxN_PANIDL, lowByte(TxQueue[TxQueue_SentIndex].pan_id));
      Mrf24j_Write(MRF24J_TxN_PANIDH, highByte(TxQueue[TxQueue_SentIndex].pan_id));
      Mrf24j_Write(MRF24J_TxN_DESTL, lowByte(TxQueue[TxQueue_SentIndex].destination));
      Mrf24j_Write(MRF24J_TxN_DESTH, highByte(TxQueue[TxQueue_SentIndex].destination));
      Mrf24j_Write(MRF24J_TxN_SOURCEL, lowByte(TxQueue[TxQueue_SentIndex].sourceaddress));
      Mrf24j_Write(MRF24J_TxN_SOURCEH, highByte(TxQueue[TxQueue_SentIndex].sourceaddress));
    
      /*
        Serial.print("Header Length (TX Buf 0): ");Serial.println(Mrf24j_Read(MRF24J_TxNHeadLength),HEX);
        Serial.print("\tPacket Length (TX Buf 1): ");Serial.println(Mrf24j_Read(MRF24J_TxNFrameLength),HEX);
        Serial.print("\tFrame Control Low byte (TX Buf 2): ");Serial.println(Mrf24j_Read(MRF24J_TxNFrmCntrl),HEX);
        Serial.print("\tFrame Control High byte (TX Buf 3): ");Serial.println(Mrf24j_Read(MRF24J_TxNFrmCntrl2),HEX);
        Serial.print("\tSequence number (TX Buf 4): ");Serial.println(Mrf24j_Read(MRF24J_TxNSeq),HEX);
        Serial.print("\tPANID (TX Buf 5,6): ");Serial.print(Mrf24j_Read(MRF24J_TxN_PANIDH),HEX);Serial.println(Mrf24j_Read(MRF24J_TxN_PANIDL),HEX);
        Serial.print("\tDestination (TX Buf 7,8): ");Serial.print(Mrf24j_Read(MRF24J_TxN_DESTH),HEX);Serial.println(Mrf24j_Read(MRF24J_TxN_DESTL),HEX);
        Serial.print("\tSource (TX Buf 9/A): ");Serial.print(Mrf24j_Read(MRF24J_TxN_SOURCEH),HEX);Serial.println(Mrf24j_Read(MRF24J_TxN_SOURCEL),HEX);
        Serial.print("\t\tPayloadSize (TX Buf B): ");Serial.println(Mrf24j_Read(MRF24J_TxN_PAYLOADSTART),HEX);
        Serial.print("\t\tPayloadByte1 (TX Buf C): ");Serial.println(Mrf24j_Read(MRF24J_TxN_PAYLOADSTART+1),HEX);
    
    
        Serial.print("\n");
        Serial.print("Header Length (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].header_length,HEX);
        Serial.print("\tPacket Length (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].frame_length,HEX);
        Serial.print("\tFrame Control (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].frame_control,HEX);
        Serial.print("\tDestination (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].destination,HEX);
        Serial.print("\tPANID (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].pan_id,HEX);
        Serial.print("\tSource (Packet): ");Serial.println(TxQueue[TxQueue_SentIndex].sourceaddress,HEX);
      */
      // Now load the payload:
      uint8_t _payloadSize = TxQueue[TxQueue_SentIndex].payload[0];  //User must supply payload length in the first byte of the array.
      Mrf24j_Write(MRF24J_TxN_PAYLOADSTART, _payloadSize);
      for (uint8_t _i = 1; _i <= _payloadSize; _i++)
      {
        Mrf24j_Write(MRF24J_TxN_PAYLOADSTART + _i, TxQueue[TxQueue_SentIndex].payload[_i]);
        // Serial.println(TxQueue[TxQueue_SentIndex].payload[_i]);
      }
    
      Mrf24j_Write(MRF24J_TXNCON, MRF24J_TXNTRIG);  // Transmit the packet
      //Serial.println(Mrf24j_Read(MRF24J_TXSTAT),BIN);
      TxQueue_SentIndex++; if(TxQueue_SentIndex > NumWHATTxMessages) TxQueue_SentIndex=0;
      //Serial.print("Tx ");Serial.println(TxQueue_SentIndex);
    }
  }
}


   #endif
}

// *****************
// TOC Individual Recieve messages
void Rx_REJECT_FULL_LINK_03 (WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{  // A link was requested, but there are not any link location available.
   // Leave the link mode.
   WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal operating state.
      Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
  *_WHAT_network_light = WHAT_NETWORK_NONE;  //
   #ifdef LINK_MONITOR
   Serial.println(F("Rx REJECT_FULL_LINK"));
   #endif
}

// *****************
// TOC Individual Recieve messages
void Rx_REMOVE_FULL_LINK_03 (WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{ // An already linked device indicated it wanted to be un-linked.
  // locate that device in the link list and set its address to "Available"
  
    for(uint8_t _i=0;_i<numWHATLinks;_i++)
  {
    if(WHATLinks[_i]==_WHAT_Rx_Packet.sourceaddress)
    {
      WHATLinks[_i]=0xFFFF;
    }
  }
  // Turn off the light and leave Link Mode.
  *_WHAT_network_light = WHAT_NETWORK_NONE;  //
  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal operating state.
     Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
   #ifdef LINK_MONITOR
   Serial.println(F("Rx REMOVE_FULL_LINK"));
   #endif
}


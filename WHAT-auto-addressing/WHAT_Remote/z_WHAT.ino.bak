// TOC PREEMIE EEPROM Values
void WHAT_Default_EEPROM_Values(void)
{
  Mrf24j_set_pan(0xFFFF);
  Mrf24j_set_SourceAddress(0xFFFF);
  mySourceAddress = 0xFFFF;
  myParentAddress = 0xFFFF;
  myLatchKeyNumber = 0xFFFF;
  myPANID = 0xFFFF;
//  myChildIndex = 0;    // each child will be indexed into the "myChildren" array.
  mySecurity = 0xFFFF;

  // Reset all link addressses.
  for(uint8_t _i=0;_i<numWHATLinks;_i++)
  {
    WHATLinks[_i]=0xFFFF;
    //#ifdef LINK_MONITOR
    //  Serial.print("Resetting Link");Serial.println(WHATLinks[_i],HEX);
    //#endif
  }
  
  // reset all child addresses:
  for(uint8_t _i=1;_i<15;_i++)
  { 
    myChildren[_i].ChildAddress = 0xFFFF;
    myChildren[_i].LatchKeyValue = 0xFFFF;
    myChildren[_i].RelationshipType = 0;
    myChildren[_i].Security = 0xFFFF;
  }
  WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03;
}

// TOC Restore PREEMIE state
bool preemie_check_restore(void)
{      //Implimenting EEPROM and preemie recovery.
       //- once a device has been connected to a network, it can be restored to its preemie state
       //- DURING POWER-UP  **HOLD** the network button.
       //- When the RED Light starts a fast blink, release the network button.
       //- the RED light will start blinking slower.
       //- Press the network button again momentarily, and preemie mode will be entered.
       //- the device will start the slow blue blink/join request.
  #define _PREEMIE_BLINK_RATE 500         // Very fast blink if button is held at power on.
  #define _PREEMIE_BLINK_RATE2 100        // Change the blink rate in the second stage of restore.
  #define _Preemie_restore_blink_timer WHAT_Reusable_Timer1
  #define _PREEMIE_RESTORE_TIMEOUT 10000 // Button must be released within this amount of time to re-set as preemie.
  #define _Preemie_restore_timer WHAT_Reusable_Timer2
  // Network button is active high, so make some defines to make it more readable.
  
  //pinMode(NETWORK_BUTTON,INPUT);

  if((*_WHAT_network_button == HIGH) | (mySourceAddress == 0xFFFF)) return 0; //Restoring a preemie requires the button to be pressed at power on.  if NOT held, return from here. (Active HIGH)
  //Serial.println(F("NetPressed"));
  // Button is currently active (high).  Flash the light very fast and wait for the button to be released.
  _Preemie_restore_timer =  millis() + _PREEMIE_RESTORE_TIMEOUT;  // Start the timer with a fresh timer value.
  _Preemie_restore_blink_timer = millis() + _PREEMIE_BLINK_RATE;  // Start the timer with a fresh timer value.
  while((_Preemie_restore_timer > millis()) & ((*_WHAT_network_button == HIGH))) // Button is active high
  {
    if(_Preemie_restore_blink_timer<millis()) 
    {
      _Preemie_restore_blink_timer = millis() + _PREEMIE_BLINK_RATE;
      *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_SEARCH_ON)? WHAT_NETWORK_SEARCH_OFF:WHAT_NETWORK_SEARCH_ON; // This is basically toggling red:  RED= !RED
    }
  }
  //the program continues either because the button was released, OR the timer expired.
  if((*_WHAT_network_button == HIGH))
  { // The button was released.  Require it to be pressed again before making the preemie.
    //Serial.println(F("NetReleased"));
    _Preemie_restore_timer =  millis() + _PREEMIE_RESTORE_TIMEOUT; // restart the timer with a fresh timer value.
    _Preemie_restore_blink_timer = millis() + _PREEMIE_BLINK_RATE2; // restart the timer with a fresh timer value.
    while((_Preemie_restore_timer > millis()) & ((*_WHAT_network_button == LOW))) //Button is active high
    {
      if(_Preemie_restore_blink_timer<millis()) 
      {
        _Preemie_restore_blink_timer = millis() + _PREEMIE_BLINK_RATE2;
        *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_ERROR)? WHAT_NETWORK_ERROR_OFF:WHAT_NETWORK_ERROR;
      }
    }// End while waiting for button or timer. 
    // either the button was released or the timer expired.
    // if the timer expired, leave this routine.
    if( _Preemie_restore_timer < millis()) {Serial.println(F("released too long.")); return false;}

    // Timer did not expire, so the button must have been pressed again.
  }// End if the button was released.
  else
  {// The button was held and never released.
    // turn off the light and leave this routine.
    //Serial.println(F("Never released. No restore."));
    *_WHAT_network_light = WHAT_NETWORK_NONE;  //
    return false;
  }
  //Serial.println(F("NetPressed. Criteria complete"));

  // preemie creation criteria met.   restore to preemie state, and continue with program initialization
  // Send an abandon network message so the parent will release the child slot, then revert to compile time values.
  WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
  _WHAT_Tx_Packet.WHAT_MAC_MESSAGE; 
  _WHAT_Tx_Packet.pan_id = myPANID;
  _WHAT_Tx_Packet.destination = myParentAddress;
  _WHAT_Tx_Packet.sourceaddress = mySourceAddress;
  uint8_t _index = 0;
  _WHAT_Tx_Packet.payload[_index++] = 6; //Total payload length (including this byte)
  _WHAT_Tx_Packet.payload[_index++] = 5; //MID length (including this byte)
  _WHAT_Tx_Packet.payload[_index++] = highByte(ABANDON_CHILD_05);
  _WHAT_Tx_Packet.payload[_index++] = lowByte(ABANDON_CHILD_05);
  _WHAT_Tx_Packet.payload[_index++] = highByte(myLatchKeyNumber);
  _WHAT_Tx_Packet.payload[_index++] = lowByte(myLatchKeyNumber);
    WHAT_TransmitPacket(_WHAT_Tx_Packet);

  WHAT_Default_EEPROM_Values();
  WHAT_StoreEEPROM();
  
  Serial.println(F("Preemie state restored."));
  *_WHAT_network_light = WHAT_NETWORK_NONE;  //
  return true;
}

// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
// ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#ifdef AUTO_ADDRESSING
// %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
// *  Network creation: - This is all built into WHAT.ino, and enabled by #define AUTO_ADDRESSING

#define _Offered_PANID  WHAT_Reusable_16t_1         // When joining a network, this is the PANID of the network being joined.
#define _Offered_SourceAddress  WHAT_Reusable_16t_2 // when  joining a network, this is the lowest new address offered.
#define _Offered_Parent WHAT_Reusable_16t_3
#define _Offered_Latchkey WHAT_Reusable_16t_4      // this is the latchkey offered by the parent with the lowest offered address.

// WHAT_Reusable_Message1 
void holdingFunction(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
  // The re-usable call has to reserve a function.
  // This will be quickly re-assigned to Rx_PROPOSE_CHILD_NUMBER_07, once it is determined that this is a preemie.
}

/*
  All new devices are programmed with PANID FFFF and source address FFFF (considered a preemie)
    When a device recognizes it is a preemie (PANID and SA are FFFF), it will periodically send a "REQUEST_JOIN_NETWORK_02" message.

    Rev 200203
      At power on, preemie sends message: REQUEST_JOIN_NETWORK_03
      Preemie has 2 possible paths:
        1) Preemie sees another REQUEST_JOIN_NETWORK_03 (another preemie), so it creates a network:
                - Send REQUEST_ACK_03 and wait for _5_ seconds.
                - if REPLY_ACKNOWLEDGE_03 recieved, change PANID and try again.
                - if timeout, use proposed PANID and source address 0000.
        2) Preemie sees a NETWORK_ALERT_PREEMIE_03 message:
                - increases BLUE blink rate and waits for NETWORK_ALLOW_PREEMIE_04 (created by a network member's network button activation.
        3) Preemie sees a NETWORK_ALLOW_PREEMIE_04 message (ONLY after seeing a NETWORK_ALERT_PREEMIE_03 message):
                - Along with NETWORK_ALLOW_PREEMIE_04 come PROPOSE_CHILD_NUMBER_07 messages.
                - Preemie keeps the lowest parent/child address offered and joins network after _5_ seconds.
                - sends ACCEPT_PARENT_08 message.
      Adult has a couple of network creation options.
        1) sees REQUEST_JOIN_NETWORK_03
              - sends NETWORK_ALERT_PREEMIE_03 and if it has a valid child slot available sends PROPOSE_CHILD_NUMBER_07
              - changes to WHAT_NEW_CHILD_REQ state.
        2) sees NETWORK_ALERT_PREEMIE_03
              - Monitors its network button.  If pressed, sends NETWORK_ALLOW_PREEMIE_04 and PROPOSE_CHILD_NUMBER_07
        3) sees NETWORK_ALLOW_PREEMIE_04 (with or without seeing REQUEST_JOIN_NETWORK_03)
              - sends PROPOSE_CHILD_NUMBER_07
     Adult in WHAT_NEW_CHILD_REQ state
        1) monitors its own network button,and (if pressed):
            - sends NETWORK_ALLOW_PREEMIE_04
            - Changes to WHAT_NEW_CHILD_ALLOWED state.
        2) monitors network messages for NETWORK_ALLOW_PREEMIE_04
            - changes to WHAT_NEW_CHILD_ALLOWED state.
        3) monitors network for CHOOSE_NETWORK_05
            - if chosen network number does not match this PANID, return to WHAT_PREEMIE_FINISHED state 
        
     Adult in WHAT_NEW_CHILD_ALLOWED
        1) Monitors network for ACCEPT_PARENT_08
           - If the accepted parent source matches this source:
              o Verify recieved child address is valid and available.
              o Add this child - Record latchkey value, and increment the child index.
              o return to WHAT_PREEMIE_FINISHED state
        2) monitors network for CHOOSE_NETWORK_05
            - if chosen network number does not match this PANID, return to WHAT_PREEMIE_FINISHED state 

    Other always monitored network messages:

*/
/*
// Rx Message flags
bool f_Rx_REQUEST_JOIN_NETWORK_03 = false;    // Preemie asking to join network
bool f_Rx_NETWORK_ALERT_PREEMIE_03 = false;   // Notice from another device that a preemie is trying to join
bool f_Rx_CHOOSE_NETWORK_05  = false;         // Notice to other networks that a network has accepted this preemie
bool f_Rx_NETWORK_ALLOW_PREEMIE_04 = false;   // Notice to this preemie that it may accept its parent.
bool f_Rx_PROPOSE_CHILD_NUMBER_07 = false;    // Preemie asking the network for a child number
bool f_Rx_NETWORK_JOIN_COMPLETE_03 = false;   // Preeemie accepted a proposed parent 
bool f_Rx_NETWORK_JOIN_ABORT_03 = false;      // User abort of the acceptance process.
bool f_Rx_REPLY_ACKNOWLEDGE_03 = false;       // While a new network is forming, requests existing network to claim its PANID
*/
// TOC PREEMIE operations 
void WHAT_CheckPreemie(void)
{
    static uint8_t _last_Preemie_state = 0xFF;    // used to see if the state has changed.
    #define NETWORK_HELD_DELAY 3000    // Time before network button is considered "HELD"
    #define Network_held WHAT_Reusable_Timer2   // IN multiple areas, this reusable timer is used for different purposes.
    RX_WHAT();  // Check for any new WHAT messages, because this while loop has to be self contained.
    Tx_What_Que();

    // Expire any stale alert gating
    if(gbl_preemie_alert_seen && (gbl_preemie_alert_expire <= millis()))
    {
      gbl_preemie_alert_seen = false;
    }

   switch (WHAT_preemie_state)
    {
      // ++++++++++++   New preemie has not seen a network yet     ++++++++++++
      case WHAT_PRE_REQUEST_JOIN_NETWORK_03:
        // TOC PREEMIE operations 
                #define _BLINK_DELAY  1000  // No network seen blink rate
                #define _BLINK_FAST   100   // Network seen faster blink rate
                #define _RQST_WAIT_TIME 30000 //Wait 30 seconds to allow user to push network button.
                #define _RQST_ACK_DELAY 5000  // wait 1 second after requesting an ACK before using the PANID
                #define _blinkTimer WHAT_Reusable_Timer1  //This will not be active while other CASEs are active.
                #define _WaitForResponses WHAT_Reusable_Timer2  //This will not be active while other CASEs are active.
        
                // New device.  request joining any network that might be availble.
                // This is a "preemie" - this device is hoping to join a network, and repeatedly sends a request to join.
                if (_last_Preemie_state != WHAT_preemie_state)
                {
                  _blinkTimer = millis(); // Used here to control the light blinking speed while in this state.
                  _WaitForResponses = millis() + _RQST_WAIT_TIME; // Amount of time to collect addresses before accepting one.
                  //Rx_NETWORK_ALLOW_PREEMIE_04 is a permanent reception message.
                  WHATRxMessage[WHAT_Reusable_Message1].MessageID = NETWORK_ALERT_PREEMIE_03;   // This message comes once the network button is pressed.
                  WHATRxMessage[WHAT_Reusable_Message1].callback = &Rx_NETWORK_ALERT_PREEMIE_03; // Message callback set here to collect the responses
                  _last_Preemie_state = WHAT_preemie_state; // This prevents this section from running all the time.
                  *_WHAT_network_light = WHAT_NETWORK_SEARCH_ON;  //
                  #ifdef LINK_MONITOR
                  Serial.println(F("Preemie Start"));Serial.println(millis());
                  #endif
                }
                if (_blinkTimer <= millis())
                {
        // TOC    Request Joining Network 
                  // toggle the network light and re-send the request for an address.
                  _blinkTimer = millis() + _BLINK_DELAY;
                  //digitalWrite( NETWORK_LIGHT, ! digitalRead(NETWORK_LIGHT)); // Make the network light solid ON.
                  *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_SEARCH_ON)? WHAT_NETWORK_SEARCH_OFF:WHAT_NETWORK_SEARCH_ON; // This is basically toggling blue:  BLUE= !BLUE // 
                  // Tx.PANID and Tx.SOURCEADDRESS are defaulted to 0xFFFF
                  WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
                  _WHAT_Tx_Packet.WHAT_MAC_MESSAGE; 
                  Mrf24j_set_pan(myPANID);
                  Mrf24j_set_SourceAddress(mySourceAddress);
                  _WHAT_Tx_Packet.pan_id = 0xFFFF;
                  _WHAT_Tx_Packet.destination = 0xFFFF;
                  _WHAT_Tx_Packet.sourceaddress = 0xFFFF;
                  uint8_t _index = 0;
                  _WHAT_Tx_Packet.payload[_index++] = 4; //Total payload length (including this byte)
                  _WHAT_Tx_Packet.payload[_index++] = 3; //MID length (including this byte)
                  _WHAT_Tx_Packet.payload[_index++] = highByte(REQUEST_JOIN_NETWORK_03);
                  _WHAT_Tx_Packet.payload[_index++] = lowByte(REQUEST_JOIN_NETWORK_03);
                  WHAT_TransmitPacket(_WHAT_Tx_Packet);
                  #ifdef LINK_MONITOR
                  Serial.println(F("Tx WHAT_PRE_REQUEST_JOIN_NETWORK_03 ")); Serial.println(millis());
                  #endif
                }
                // ooo One way out is to form a network ooo
        // TOC    Creating a new network 
                if(f_Rx_REQUEST_JOIN_NETWORK_03)
                { // Another preemie is looking for a network, and this device has not joined a network.
                  // Form a new network.
                  f_Rx_REQUEST_JOIN_NETWORK_03 = false; // clear the message flag when it is used.
                  myPANID = (uint16_t) millis();  // Make up a new PANID based on the timer.  This will be a pretty random value.
                  Mrf24j_set_pan(myPANID);
             
                  //prepare to recieve an ACK request from the chosen PANID. If other devices respond, then this address is already used.
                  //re-configure the reusable message to receive an ACK from an existing network.
                  WHATRxMessage[WHAT_Reusable_Message1].MessageID = REPLY_ACKNOWLEDGE_03;
                  WHATRxMessage[WHAT_Reusable_Message1].callback = &Rx_REPLY_ACKNOWLEDGE_03; // Message callback set here to collect the responses
              
        // TOC    Avoiding network conflicts 
                  // Now send the ACK request
                  // If anything replies, then this network already exists, and a new PANID will be chosen.
                  Tx_REQUEST_ACK_03();
                        
                  // Start a delay timer.  If it expires with no ACK reply, this PANID is acceptable.
                  _WaitForResponses = millis() + _RQST_ACK_DELAY;
                  WHAT_preemie_state = WHAT_PRE_NEW_NETWORK_ACK; // change to this state.
                  Serial.print(F("Creating Network @ ")); Serial.println(myPANID, HEX);
                  *_WHAT_network_light = WHAT_NETWORK_CREATING_ON;  //Creating network, and delaying to see if this PANID is already used.
                }
                // ooo another way out is to be allowed into an existing network ooo
        // TOC    Network identified, waiting to be allowed 
                 if(f_Rx_NETWORK_ALERT_PREEMIE_03)
                {
                  f_Rx_NETWORK_ALERT_PREEMIE_03 = false; // clear the message flag when it is used.
                  WHAT_preemie_state = WHAT_NETWORK_SEEN;
                  //#ifdef LINK_MONITOR
                  //Serial.print(F("AnotherNetworkSeen: ")); //Serial.println(millis(), HEX);
                  //#endif
               }
                break;

     // ++++++++++++   Preemie is forming a network      ++++++++++++
      case WHAT_PRE_NEW_NETWORK_ACK:
        // TOC    Creating a new network 
               //Serial.println("wait for NETWORK_ACK");
                // This device created a network, and sent an ACK request to verify its PANID is not used.
                // wait here for a period of time, and if no reply arrives, then make the network.
                if( f_Rx_REPLY_ACKNOWLEDGE_03)
                  {// Ack seen.  try a different address.
                    // As a preemie converting to a network creator, this device will send a
                    // request for ACK to see if the PANID it chose is already used.
                    // So, this message should NOT be recieved, (because to get to this point,
                    //  2 preemies are within range of each other, and they have not been accepted into another
                    //  network, and the new PANID is randomly chosen, so it will probably not match.
                    // But if it DOES happen, just try a different PANID.
                    f_Rx_REPLY_ACKNOWLEDGE_03 = false; // clear the message flag when it is used.
                    Tx_REQUEST_ACK_03();
                
                    // Start a delay timer.  If it expires with no ACK reply, this PANID is acceptable.
                    WHAT_Reusable_Timer1 = millis() + _RQST_ACK_DELAY;
                    //WHAT_preemie_state = WHAT_PRE_NEW_NETWORK_ACK; // stay in this state.
                  #ifdef LINK_MONITOR
                  Serial.print(F("Trying new PANID : ")); Serial.println(millis());
                  #endif
                  }
                if (_WaitForResponses <= millis())
                {
                  //Use the current PANID and leave PREEMIE mode.
                  //Serial.print(WHAT_Reusable_Timer1); Serial.print(" <- Timer     millis-> "); Serial.println(millis());
                  Serial.print(F("Network Created. PANID: 0x")); Serial.println(myPANID, HEX);
                  //WHAT_Default_EEPROM_Values();
                  mySourceAddress = 0;  // When forming a new network, start with the address 0x0000
                  myParentAddress = 0;  // This is the only device that is its own parent.
                  myLatchKeyNumber = millis();  // This device will make its own latchkey number (which really can not be used, because no one will know it.
                  //myChildIndex = 0;             // When forming a new network, this device will start with no children.
                  mySecurity = myLatchKeyNumber; // use this device's latchkey number as the base security number.
                  //Mrf24j_set_pan(myPANID);
                  Mrf24j_set_SourceAddress(mySourceAddress);
              
                  //Serial.print("Pre-Store PANID:0x"); Serial.println(myPANID);
                  WHAT_StoreEEPROM();
                  Serial.println(F("EEPROM Stored"));
        
                  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Control will transition to the program loop from here.
                  *_WHAT_network_light = WHAT_NETWORK_CREATED; //This device created a network.
                  Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                }
                break;

      // +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++  
      // ++++++++++++   Preemie is joining a network      ++++++++++++
      case WHAT_NETWORK_SEEN:
        // TOC    Network identified, waiting to be allowed (only if ALERT was seen)
                if (_last_Preemie_state != WHAT_preemie_state)
                {
                  _last_Preemie_state = WHAT_preemie_state; // This prevents this section from running all the time.
                  _WaitForResponses = millis() + _RQST_WAIT_TIME; // reset the timer so it can leave if messages stop.
                  _blinkTimer = millis() + _BLINK_FAST;
                  gbl_preemie_alert_seen = true;
                  gbl_preemie_alert_expire = millis() + PREEMIE_ALERT_HOLD_MS;
                  #ifdef LINK_MONITOR
                  Serial.print(F("PREEMIE sees network (alert): ")); //Serial.println(millis());
                  #endif
                  // This is the initial run through for this state.
                  // Keep an eye out for offered child slots.
                  _Offered_PANID = 0xFFFF; // These are collected in  Rx_PROPOSE_CHILD_NUMBER_07 to
                  _Offered_SourceAddress = 0xFFFF; // identify the lowest offered address seen.
                  _Offered_Latchkey = 0xFFFF;
                  WHATRxMessage[WHAT_Reusable_Message1].MessageID = NETWORK_ALLOW_PREEMIE_04;  // these are prospective parents offering free addresses.
                  WHATRxMessage[WHAT_Reusable_Message1].callback = &Rx_NETWORK_ALLOW_PREEMIE_04; // Message callback set here to collect the responses
                }
              
                if (_blinkTimer <= millis())
                {
                  _blinkTimer = millis() + _BLINK_FAST;
                 *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_JOINING_ON)? WHAT_NETWORK_JOINING_OFF:WHAT_NETWORK_JOINING_ON; // Fast blue blink: alert seen
                }
                if (_WaitForResponses <= millis())
                {
                  // When the LONG timeout occurs, revert to the request state.
                  WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03;
                  *_WHAT_network_light = WHAT_NETWORK_NONE;
                  gbl_preemie_alert_seen = false;
                  #ifdef LINK_MONITOR
                  Serial.print(F("Response Timeout : ")); Serial.println(millis());
                  #endif
                }
                if(f_Rx_NETWORK_ALLOW_PREEMIE_04 && gbl_preemie_alert_seen)
                {// This preemie has been accepted to a network after alert was seen.
                  f_Rx_NETWORK_ALLOW_PREEMIE_04 = false; // clear the message flag when it is used.
                  gbl_preemie_alert_seen = false; // consume the alert gate
                  if (_Offered_PANID < 0xFFFF) // Only do this if a PANID was offered.
                    {
                      WHAT_preemie_state = WHAT_PRE_NETWORK_ALLOW_PREEMIE_04; // proceed to allow window
                      _WaitForResponses = millis() + _RQST_ACK_DELAY;
                  #ifdef LINK_MONITOR
                    Serial.print(F("Offered PANID:0x")); Serial.println(_Offered_PANID,HEX);
                  #endif
                      *_WHAT_network_light = WHAT_NETWORK_JOINING_ON; // Alternate blue/green handled in next state
                    }
                }
                 // If an abort message is recieved, return to the beginning.
                  if(f_Rx_NETWORK_JOIN_ABORT_03) 
                  {
                    f_Rx_NETWORK_JOIN_ABORT_03 = false; // clear the message flag when it is used.
                    WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03; // If nothing offered a child slot, return to being a preemie.
                    *_WHAT_network_light = WHAT_NETWORK_ERROR; //Give the lamp color/text that indicates that the connection was aborted.
                    gbl_preemie_alert_seen = false;
                  #ifdef LINK_MONITOR
                    Serial.print(F("Joining error : ")); Serial.println(millis());
                  #endif
                  }
                break;
        
      // +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++  
      // ++++++++++++  Preemie is waiting for a proposed ID    ++++++++++++
      case WHAT_PRE_NETWORK_ALLOW_PREEMIE_04:
        // TOC    Accepted to existing network (must have prior alert)
                // A button on the network has permitted this preemie to join.
                // This preemie responds with acceptance of the lowest proposed address.
                if (_blinkTimer <= millis())
                {
                  _blinkTimer = millis() + _BLINK_FAST;
                  // Alternate blue/green to indicate allow/proposal window
                  *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_JOINING_ON)? WHAT_NETWORK_JOINING_OFF:WHAT_NETWORK_JOINING_ON;
                }
                  if (_WaitForResponses <= millis()) //Wait a short time after permitted to join to get more proposed addresses.
                  {
                    if(_Offered_SourceAddress < 0xFFFF)
                    {  
                      myPANID = _Offered_PANID;
                      Mrf24j_set_pan(myPANID);
                      mySourceAddress = _Offered_SourceAddress;
                      Mrf24j_set_SourceAddress(mySourceAddress);
                      WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
                      _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
                      _WHAT_Tx_Packet.pan_id = _Offered_PANID;
                      _WHAT_Tx_Packet.sourceaddress = _Offered_SourceAddress;
                      myParentAddress = _Offered_Parent;
                      myLatchKeyNumber = (uint16_t)millis();  //Create a random latch-key number
                      _WHAT_Tx_Packet.pan_id = myPANID;
                      _WHAT_Tx_Packet.sourceaddress = mySourceAddress;
                      _WHAT_Tx_Packet.destination = myParentAddress;   // Direct this message at the parent that accepted it.
                      uint8_t _index = 0;
                      _WHAT_Tx_Packet.payload[_index++] = 9; //Total payload length (including this byte)
                      _WHAT_Tx_Packet.payload[_index++] = 8; //MID length (including this byte)
                      _WHAT_Tx_Packet.payload[_index++] = highByte(ACCEPT_PARENT_08);
                      _WHAT_Tx_Packet.payload[_index++] = lowByte(ACCEPT_PARENT_08);
                      _WHAT_Tx_Packet.payload[_index++] = highByte(myParentAddress);
                      _WHAT_Tx_Packet.payload[_index++] = lowByte(myParentAddress);
                      _WHAT_Tx_Packet.payload[_index++] = highByte(myLatchKeyNumber);
                      _WHAT_Tx_Packet.payload[_index++] = lowByte(myLatchKeyNumber);
                      _WHAT_Tx_Packet.payload[_index++] = WHAT_PERMANENT;           // All devices are permanent at this point.
                         WHAT_TransmitPacket(_WHAT_Tx_Packet);
        
                      WHAT_preemie_state = WHAT_PREEMIE_FINISHED;
                      WHAT_StoreEEPROM();
                      *_WHAT_network_light = WHAT_NETWORK_JOINED;  // Network light to indicate someone else's network was sucessfully joined.
                      Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                      Serial.println(F("Tx Parent Accepted"));
                      Serial.println(F("PANID\tmySourceAddress\tmyLatchKeyNumber\tmyParentAddress"));
                      Serial.print(myPANID,HEX);Serial.print("\t");Serial.print(mySourceAddress,HEX);Serial.print("\t");Serial.print(myLatchKeyNumber,HEX);Serial.print("\t");Serial.println(myParentAddress,HEX);
                    }
                    else
                    { // No source address was offered. re-start the preemie process.
                      WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03; // If nothing offered a child slot, return to being a preemie.
                      *_WHAT_network_light = WHAT_NETWORK_ERROR;  //blip of red indication network was not joined.
                    }
                  }
                 // If an abort message is recieved, return to the beginning.
                  if(f_Rx_NETWORK_JOIN_ABORT_03) 
                  {
                    f_Rx_NETWORK_JOIN_ABORT_03 = false; // clear the message flag when it is used.
                    WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03; // If nothing offered a child slot, return to being a preemie.
                    *_WHAT_network_light = WHAT_NETWORK_ERROR;  //blip of red indication network was not joined.
                 }
        
                break;
      case WHAT_PREEMIE_FINISHED:

                // This case results when booting and restoring from EEPRPOM as an adult.
                // the software always does "Check preemie" on boot, so nothing really to
                // do if this device is not a preemie, so just exit.
                break;
      default:
                //Serial.print(F("Unhandled PREEMIE state:"));Serial.println(WHAT_preemie_state);
                // If in an invalid state, revert to being a preemie.
                 #ifdef LINK_MONITOR
                  //Serial.print(F("Offered PANID:0x")); Serial.println(_Offered_PANID);
                  Serial.print(F("Undefined Preemie state : ")); Serial.println(WHAT_preemie_state,HEX);
                #endif
                WHAT_preemie_state = WHAT_PRE_REQUEST_JOIN_NETWORK_03; // If nothing offered a child slot, return to being a preemie.
                *_WHAT_network_light = WHAT_NETWORK_ERROR;  //blip of red indication network was not joined.
                break;
  }// Switch
  //Serial.print(F("Not a Preemie: PANID:0x"));Serial.print(myPANID,HEX); Serial.print(F("\t SourceAddress:0x")); Serial.print(mySourceAddress,HEX); Serial.print(F("\t ParentAddress:0x")); Serial.println(myParentAddress,HEX);
  //WHAT_network_seen = false;  // Just in case preemie mode is re-entered after a network was seen.
}// Check Preemie
 
// ******************** Rx Messages
// non-reusable message.  different functions when a preemie.
// TOC Individual Recieve messages
void Rx_REQUEST_JOIN_NETWORK_03 (WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
   f_Rx_REQUEST_JOIN_NETWORK_03 = true;
}  

// TOC Individual Recieve messages 
void Tx_REQUEST_ACK_03(void)
{        
    myPANID = (uint16_t) millis();  // Make up a new PANID based on the timer.  This will be a pretty random value.
    WHAT_Packet _WHAT_Tx_Packet;
    _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
    // Now send the ACK request
    Mrf24j_set_pan(myPANID);
    _WHAT_Tx_Packet.pan_id = myPANID;      // Use the desired PANID so only that PANID will reply (if it is already used)
    _WHAT_Tx_Packet.destination = 0xFFFF;  // Send to ANY device with this PANID.
    _WHAT_Tx_Packet.sourceaddress = 0xFFFF;  // no source address claimed yet, in case another network has this address.
    uint8_t _index = 0;
    _WHAT_Tx_Packet.payload[_index++] = 3; //Total payload length (including this byte)
    _WHAT_Tx_Packet.payload[_index++] = 2; //MID length (including this byte)
    _WHAT_Tx_Packet.payload[_index++] = highByte(REQUEST_ACK_03);
    _WHAT_Tx_Packet.payload[_index++] = lowByte(REQUEST_ACK_03);
      WHAT_TransmitPacket(_WHAT_Tx_Packet);
                 #ifdef LINK_MONITOR
                  Serial.print(F("Asking for ACK on :0x")); Serial.println(myPANID);
                  //Serial.print(F("Undefined Preemie state : ")); Serial.println(WHAT_preemie_state,HEX);
                #endif
}

// TOC Individual Recieve messages 
// WHAT_Reusable_Message1 
void Rx_REPLY_ACKNOWLEDGE_03(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
// Rx Message flags
  f_Rx_REPLY_ACKNOWLEDGE_03 = true;       // While a new network is forming, requests existing network to claim its PANID
                 #ifdef LINK_MONITOR
                  Serial.print(F("Recieve ACK from :0x")); Serial.println(_WHAT_Rx_Packet.pan_id);
                  //Serial.print(F("Undefined Preemie state : ")); Serial.println(WHAT_preemie_state,HEX);
                #endif
}

// &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
// &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
// &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
// &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

// TOC Adult operations 
void WHAT_CheckAdult(void)
{
  #define _BLINK_DELAY  1000  // No network seen blink rate
  #define _BLINK_FAST   100   // Network seen faster blink rate
  #define _RQST_WAIT_TIME 30000 //Wait 30 seconds to allow user to push network button.
  #define _RQST_ACK_DELAY 5000  // wait 5 second after requesting an ACK before using the PANID
  #define _blinkTimer WHAT_Reusable_Timer1  //This will not be active while other CASEs are active.

  #define Network_held WHAT_Reusable_Timer2   // IN multiple areas, this reusable timer is used for different purposes.
  #define _WaitForResponses WHAT_Reusable_Timer2  //This will not be active while other CASEs are active.
  #define _WHAT_NEW_CHILD_TIME_DELAY 30000 // Only stay in new child mode for 30 seconds if not accepted earlier.
  #define _WHAT_Already_Linked WHAT_Reusable_8t_1  //used to debounce the network button.
  //Serial.println("memberloop");

  switch (WHAT_preemie_state)
  {
    // ************************************************************************
    // This should be the predominant state.  Once a network is joined or created,
    // This device will just watch for a few MAC messages.
    case WHAT_PREEMIE_FINISHED:
// TOC    Normal Adult operations 
             // If no network activity is currently underway, monitor network button interactions.
             //#define Network_held WHAT_Reusable_Timer2  //This will not be active while other CASEs are active.
             #ifndef NETWORK_HELD_DELAY
               #define NETWORK_HELD_DELAY 5000    // Time before network button is considered "HELD"
             #endif
             
              if ((*_WHAT_network_button == HIGH) & (Network_held<millis()))
              { 
                // during normal operation, if the network button is held for several seconds
                // this device will send a REQUEST_FULL_LINK message, and wait for a reply.
                 #ifdef LINK_MONITOR
                 Serial.println(F("Held"));
                 #endif
                 // Any digital inputs of the other device will control digital outputs of this device. 
                 // First, be sure this device has an extra link spot available.
                  f_REQUEST_FULL_LINK_03 = false;
                  uint8_t _WHAT_Already_Linked = 0xFF;
                  // Make sure there is an empty link location...
                  for (uint8_t _i=0;_i<numWHATLinks;_i++)
                  {
                   #ifdef LINK_MONITOR
                   Serial.println(WHATLinks[_i],HEX);
                   #endif
                    if((WHATLinks[_i] ==0xFFFF) & (_WHAT_Already_Linked==0xFF)) 
                    {
                      _WHAT_Already_Linked = _i;
                    }
                  }
                  
                 if(_WHAT_Already_Linked <0xFF)
                 { // An empty slot was found for linking this device.
                   #ifdef LINK_MONITOR
                   Serial.println(F("Tx Rqst Link"));
                   #endif
                   Tx_REQUEST_FULL_LINK();  // Request linking across the network.
                   *_WHAT_network_light = WHAT_LINKING_ON; //
                   f_ACCEPT_FULL_LINK_03 = false;  // MAke sure previously set flag is cleared.     
                   WHAT_preemie_state = WHAT_LINKING_INITIATED; // Return to normal if the connection is aborted.
                  _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                }// End if slot available
              } // End if network button is NOT activated
              else
              { // Link button is being activated.
                if(*_WHAT_network_button == LOW)
                {
                  Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer  
                }    
                // Just see how long it is held.
              }
              // *****************
              // Trying to always turn the light off after some time, but this is conflicting with the flash timer.
              if(_blinkTimer<millis())
              { // Turn off the light every so often if nothing is active.
                _blinkTimer = millis() + _RQST_WAIT_TIME;
                *_WHAT_network_light = WHAT_NETWORK_NONE; // Turn the light off.
              }
        
              // *****************
              if(f_REQUEST_FULL_LINK_03)
              { // Another device is requesting a link.
                 f_REQUEST_FULL_LINK_03 = false; 
                 _WHAT_Already_Linked = 0xFF; // Default to NOT available for link
                 uint8_t _blankspot = 0xFF;
                 // Link is being requested. If this is already linked, show solid light, if Not, blink light..
                 for (uint8_t _i=0;_i<numWHATLinks;_i++)
                 {
                   #ifdef LINK_MONITOR
                   Serial.println(WHATLinks[_i],HEX);
                   #endif
                   if((WHATLinks[_i] == _Offered_SourceAddress)) _WHAT_Already_Linked = _i; // This device was previously linked.
                   if((_blankspot == 0xFF) & (WHATLinks[_i] == 0xFFFF)) _blankspot = _i; // Keep track fo teh first blank spot
                 }
                 if(_WHAT_Already_Linked == 0xFF) _WHAT_Already_Linked = _blankspot; // if not already linked, use the blank spot.
                 // Now "_WHAT_Already_Linked" = either the location of previous link, an empty spot, or 0xFF if neither found,
                 WHAT_preemie_state = WHAT_LINK_REQUESTED; // Indicate another device requests a link.
                 _blinkTimer = millis() + _BLINK_FAST;
                 _WaitForResponses = millis()+ _RQST_WAIT_TIME; // Reset the network held timer      
               #ifdef LINK_MONITOR
                Serial.print(F("_WHAT_Already_Linked value: "));Serial.println(_WHAT_Already_Linked);
                Serial.print(F("WHATLinks[_i] value: "));Serial.println(WHATLinks[_WHAT_Already_Linked]);
               #endif
               }
              break;
              
// ************************************************************************
// TOC    Child requesting addition to network 
    case WHAT_NEW_CHILD_REQ:
              // A preemie is trying to join this network.
              // This state is set whether this device proposed an address, or a NETWORK_ALERT_PREEMIE_03  MID was seen.
              // If this is the case, if the network button on this device is pressed, notify the network and child that
              // the operator is allowing it to join.
              if (_blinkTimer <= millis())
              {
                _blinkTimer = millis() + _BLINK_FAST;
                // Blink the network lights so the user knows to push a button.
                *_WHAT_network_light = (*_WHAT_network_light== WHAT_CHILD_REQUEST_ON)? WHAT_CHILD_REQUEST_OFF:WHAT_CHILD_REQUEST_ON; // This is basically toggling green:  GREEN= !GREEN
              }
              if ((*_WHAT_network_button == HIGH)) // Button is active high.
              {
                //_last_NetworkButton = digitalRead(NETWORK_BUTTON);  // Debounce the input button.
                //Serial.println(F("Allowing child"));
                _WaitForResponses = millis() + _WHAT_NEW_CHILD_TIME_DELAY;  //This state will only remain active a short time.
                // Send out a proposal for a child which includes Child Allowed.
                Tx_PROPOSE_CHILD_NUMBER_05();
                WHAT_preemie_state = WHAT_NEW_CHILD_ALLOWED;   // The operator pressed the button to accept the new child.
                  #ifdef LINK_MONITOR
                  //Serial.print(F("Recieve ACK from :0x")); Serial.println(_WHAT_Tx_Packet.pan_id);
                  Serial.println(F("Button WHAT_NEW_CHILD_ALLOWED"));
                  #endif
                *_WHAT_network_light = WHAT_NEW_CHILD_ALLOWED_ON; // 
              }
              
              if(f_Rx_NETWORK_ALLOW_PREEMIE_04)
              {
                // If this device is already a member of the network,
                // send a proposal for a child address
                f_Rx_NETWORK_ALLOW_PREEMIE_04 = false; // clear the message flag when it is used.
                _WaitForResponses = millis() + _WHAT_NEW_CHILD_TIME_DELAY;  //This state will only remain active a short time.
                // Send out a proposal for a child
                Tx_PROPOSE_CHILD_NUMBER_05();
                // There are seperate state machines for preemies and members, each handle the NETWORK_ALLOW_PREEMIE_04 state, but in different state machines.
                WHAT_preemie_state = WHAT_NEW_CHILD_ALLOWED;
                  #ifdef LINK_MONITOR
                    Serial.println(F("Rx WHAT_NEW_CHILD_ALLOWED"));
                  #endif
                *_WHAT_network_light = WHAT_NEW_CHILD_ALLOWED_ON; // 
              }
         // TOC    Network identified, waiting to be allowed
              if (_WaitForResponses <= millis()) //Timer set when a child request is seen.  there is 30seconds to connect.
              {
                Serial.println(F("\n Allow timer expired"));
                WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Reset to the "normal" state when the timer expires.
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                *_WHAT_network_light = WHAT_NETWORK_CREATED; //the child did not join, but this device's network is still active.
              }
              break;

// ************************************************************************
    case WHAT_NEW_CHILD_ALLOWED:
// TOC    New child allowed to be added to network 
              // The network has approved for the new child to be added.
              //Serial.println(F("WHAT_NEW_CHILD_ALLOWED"));
              
              if (_WaitForResponses <= millis()) //Timer set when a network button was pressed.  there is 30seconds to connect.
              {
                WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Reset to the "normal" state when the timer expires.
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                 Serial.println(F("New Child Timeout"));
                *_WHAT_network_light = WHAT_NETWORK_CREATED; //the child did not join, but this device's network is still active.
              }
              if(f_Rx_ACCEPT_PARENT_08)
              {
                // A new child has accepted this device as its parent.
                // The required steps are handled in the receipt of the message, so this routine will never execute.
                WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Reset to the "normal" state when the timer expires.
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                 Setup_WHAT_Show_Connection();
                Serial.println(F("New Child Accepted"));
                //Serial.println(F("Child accepted."));
                //Serial.println(F("PANID\tMyChild\tmyLatchkey\tmyRelationship"));
                //Serial.print(myPANID);Serial.print(myChildren[_myChild_available_Index].ChildAddress);Serial.print(myChildren[_myChild_available_Index].LatchKeyValue);Serial.println(myChildren[_myChild_available_Index].RelationshipType);
                *_WHAT_network_light = WHAT_NETWORK_JOINED;
              }
              break;

// ************************************************************************
    case WHAT_LINKING_INITIATED:
// TOC    This Device attempting to link to another device 
              // This device requested a link.  wait for another device to accept the link.
              // Blink Blue while waiting.
              static bool _NetButtonWasReleased = false;  // 
              if (_blinkTimer <= millis())
              {
                _blinkTimer = millis() + _BLINK_FAST;
                // Blink the network lights so the user knows to push a button.
                *_WHAT_network_light = (*_WHAT_network_light== WHAT_LINKING_ON)? WHAT_LINKING_OFF:WHAT_LINKING_ON; // This is basically toggling blue:  BLUE= !BLUE
              }
              if(_WaitForResponses < millis()) 
              {
                #ifdef LINK_MONITOR
                Serial.println(F("Link to me -timeout-"));
                #endif
                Tx_REJECT_FULL_LINK_03();   // Let other devices know the link was rejected.
                _NetButtonWasReleased = false; // reset the previous state once it was used.
                WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // no response.  act like it never happened.  
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                *_WHAT_network_light = WHAT_NETWORK_ERROR; // Indicate link failed.
              }
              if((*_WHAT_network_button == LOW))
              {// Linker aborted by pressing the link button again.
                if(_NetButtonWasReleased == true) // the button is pressed in order to get to this routine.  require it be released.
                {
                  Tx_REJECT_FULL_LINK_03();
                  _NetButtonWasReleased = false; // reset the previous state once it was used.
                  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // no response.  act like it never happened.  
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                  *_WHAT_network_light = WHAT_NETWORK_ERROR; // Indicate finished seeking link.
                }
              }
              else
              {
               _NetButtonWasReleased = true; // Once the network button has been released, it can be used.
              }
              if(f_ACCEPT_FULL_LINK_03)
              { // Link accepted.  
                // Make sure the offered address is not already linked...
                _WHAT_Already_Linked = 0xFF;
                for (uint8_t _i=0;_i<numWHATLinks;_i++)
                {
                  if(WHATLinks[_i] == _Offered_SourceAddress) {_WHAT_Already_Linked = _i;_i=numWHATLinks;} // Match found.  no further search is necessary
                }
                if(_WHAT_Already_Linked == 0xFF)
                { // This address was not already linked. Put it in the first available spot.
                  for (uint8_t _i=0;_i<numWHATLinks;_i++)
                  {
                    if(WHATLinks[_i] == 0xFFFF)
                    {
                      WHATLinks[_i] = _Offered_SourceAddress;
                      _WHAT_Already_Linked = _i;
                      _i = numWHATLinks;
                      }
                  }
                }
                // if it was already in the list, no need to add it.
               _NetButtonWasReleased = false; // reset the previous state once it was used.
                WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Reset to the "normal" state when the timer expires.
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                *_WHAT_network_light = WHAT_LINKED; // Indicate success.
                _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                
                #ifdef LINK_MONITOR
                Serial.println(F("Link to me -Accepted-"));
                Serial.print(F("List Location: "));Serial.println(_WHAT_Already_Linked);
                Serial.print(F("WHATLinks[_i] value: 0x"));Serial.println(WHATLinks[_WHAT_Already_Linked],HEX);
               #endif
               }
              break;
// ************************************************************************
    case WHAT_LINK_REQUESTED:
// TOC    Another device is attempting to link to this device
              //another device is requesting a link.  If the button on this is pressed, this will join.
              // Before giving the chance, make sure this device is not already connected.
              // *********
              if((_WHAT_Already_Linked <= numWHATLinks) & (WHATLinks[_WHAT_Already_Linked] ==0xFFFF))
              { // An empty link spot is available, and this device was not previously linked.
                // Blink Blue while waiting.
                if (_blinkTimer <= millis())
                {
                  _blinkTimer = millis() + _BLINK_FAST;
                  // Blink the network lights so the user knows to push a button.
                  *_WHAT_network_light = (*_WHAT_network_light== WHAT_LINKING_ON)? WHAT_LINKING_OFF:WHAT_LINKING_ON; // This is basically toggling blue:  BLUE= !BLUE
                }
                if(Network_held < millis()) 
                {
                   #ifdef LINK_MONITOR
                    Serial.println(F("Linking timeout"));
                   #endif
                  // Transmit Link abandoned.
                  Tx_REJECT_FULL_LINK_03();   // Let other devices know the link was rejected.
                  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // no response.  act like it never happened.  
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                 _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                  *_WHAT_network_light = WHAT_LINKFAILED; // Link failed.
                }
                // respond to link is network button is pressed.
                if ((*_WHAT_network_button == LOW))
                { // Link accepted.  
                #ifdef LINK_MONITOR
                Serial.print(F("Link Accepted to : 0x"));Serial.println(_Offered_SourceAddress,HEX);
                #endif
                  WHATLinks[_WHAT_Already_Linked] = _Offered_SourceAddress;
                  _EEPROM_store_links();  // Update the link list table with the new address.
                  // Tx link Confirmation
                  WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
                  _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
                  // In all cases, if a child address is being proposed, also inform the network that a preemie wants to join.
                  // In addition to proposing a child, tell the entire network that a child is trying to join:
                  _WHAT_Tx_Packet.pan_id = myPANID;
                  _WHAT_Tx_Packet.destination = _Offered_SourceAddress;   // Send this to all devices.
                  _WHAT_Tx_Packet.sourceaddress = mySourceAddress;  // Use the source ddress of this device.
                  uint8_t _index = 0;
                  _WHAT_Tx_Packet.payload[_index++] = 4; //Total payload length (including this byte)
                  _WHAT_Tx_Packet.payload[_index++] = 3; //MID length (including this byte)
                  _WHAT_Tx_Packet.payload[_index++] = highByte(ACCEPT_FULL_LINK_03);
                  _WHAT_Tx_Packet.payload[_index++] = lowByte(ACCEPT_FULL_LINK_03);
                   WHAT_TransmitPacket(_WHAT_Tx_Packet);
        
                  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // no response.  act like it never happened.  
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                  Setup_WHAT_Show_Connection();
                  *_WHAT_network_light = WHAT_LINKED; // Turn the link light green an indication of acceptance.
                  _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                }// End If network button pressed.
              } // End Empty slot available.
              else      // *********
              {
                if(WHATLinks[_WHAT_Already_Linked] <0xFFFF)
                { // Link location holds a valid address (previously linked).  If the button is pressed, un-link.
                  *_WHAT_network_light = WHAT_LINKING_ON; // Turn the link light solid blue to indicate already linked.
                  if ((*_WHAT_network_button == HIGH)) // Button is active high.
                  {
                    #ifdef LINK_MONITOR
                    Serial.print(F("Unlink :0x"));Serial.println(WHATLinks[_WHAT_Already_Linked]);
                    #endif
                    WHATLinks[_WHAT_Already_Linked] = 0xFFFF;
                    _EEPROM_store_links();  // Update the link list table with the new address.
                    WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
                    _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
                    // In all cases, if a link is being removed, also inform the other device that it should be removed from the link table.
                    _WHAT_Tx_Packet.pan_id = myPANID;
                    _WHAT_Tx_Packet.destination = _Offered_SourceAddress;   // Send this to the previously linked device.
                    _WHAT_Tx_Packet.sourceaddress = mySourceAddress;  // Use the source address of this device.
                    uint8_t _index = 0;
                    _WHAT_Tx_Packet.payload[_index++] = 4; //Total payload length (including this byte)
                    _WHAT_Tx_Packet.payload[_index++] = 3; //MID length (including this byte)
                    _WHAT_Tx_Packet.payload[_index++] = highByte(REMOVE_FULL_LINK_03);
                    _WHAT_Tx_Packet.payload[_index++] = lowByte(REMOVE_FULL_LINK_03);
                     WHAT_TransmitPacket(_WHAT_Tx_Packet);
          
                    WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Leave Preemie state.  
                     Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                   *_WHAT_network_light = WHAT_LINKING_OFF; // Turn the link light back off.
                    _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                  } // end button being pressed (Accepted link)
                }// end If already linked.
                else
                // *********
                { // Not already linked and no room for an additional link.
                  // ignore the link request
                  #ifdef LINK_MONITOR
                  Serial.println(F("No Available Link Spots"));
                  #endif
                  WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // no free address.  act like it never happened.  
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
                 *_WHAT_network_light = WHAT_LINKFAILED; // Turn the link light back off, since it can not be linked.
                  _WaitForResponses = millis() + _RQST_WAIT_TIME; // Keep it green for several seconds.
                } // End Else no link, no room
              }// End else no empty slot 
              break;
             
    default:
              // other checks:
       break;
  }// End Switch
      
  //Look for other messages of interest:
  if(f_Rx_REQUEST_JOIN_NETWORK_03)
  {
    f_Rx_REQUEST_JOIN_NETWORK_03 = false; // clear the message flag when it is used.
    // Send Network Alert.
    WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
    _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
    // In all cases, if a child address is being proposed, also inform the network that a preemie wants to join.
    // In addition to proposing a child, tell the entire network that a child is trying to join:
    _WHAT_Tx_Packet.pan_id = myPANID;
    _WHAT_Tx_Packet.destination = 0xFFFF;   // Send this to all devices.
    _WHAT_Tx_Packet.sourceaddress = mySourceAddress;  // Use the source ddress of this device.
    uint8_t _index = 0;
    _WHAT_Tx_Packet.payload[_index++] = 5; //Total payload length (including this byte)
    _WHAT_Tx_Packet.payload[_index++] = 4; //MID length (including this byte)
    _WHAT_Tx_Packet.payload[_index++] = highByte(NETWORK_ALERT_PREEMIE_03);
    _WHAT_Tx_Packet.payload[_index++] = lowByte(NETWORK_ALERT_PREEMIE_03);
     WHAT_TransmitPacket(_WHAT_Tx_Packet);
     
    WHAT_preemie_state = WHAT_NEW_CHILD_REQ;  // Let this device know a preemie is trying to join.
    *_WHAT_network_light = WHAT_CHILD_REQUEST_ON; // 
    _blinkTimer = millis() + _BLINK_FAST;
    _WaitForResponses = millis() + _RQST_WAIT_TIME;
    //Serial.println(F("Rx_REQUEST_JOIN_NETWORK_03"));
    
   }// end if my proposed address is valid.

   if(f_Rx_NETWORK_ALERT_PREEMIE_03)
   {
      f_Rx_NETWORK_ALERT_PREEMIE_03 = false; // clear the message flag when it is used.
      // The network has given an alert that a preemie is trying to join the network.
      // During that time, if this device address is <0x0100 it will monitor its network button
      // and send an acceptance signal if it is pressed.
      //Serial.println(F("Rx_NETWORK_ALERT_PREEMIE_03"));
      //WHAT_network_seen = true;
      _WaitForResponses = millis() + _RQST_WAIT_TIME; // Once a network is seen, slow the rate of requests.
      WHAT_preemie_state = WHAT_NEW_CHILD_REQ;
      *_WHAT_network_light = WHAT_NETWORK_CREATING_ON;
   }
  if(f_Rx_CHOOSE_NETWORK_05)
  {// When a preemie chooses a network, if it is not THIS network, revert to finished state.
      //Serial.println(F("Rx_CHOOSE_NETWORK_05"));
    f_Rx_CHOOSE_NETWORK_05 = false; // clear the message flag when it is used.
    if (_Offered_PANID != myPANID) //Only respond if mature and if the given PANID does not match this one.
      {
          WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal if a different PANID is used.
                 Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
      }
  }
   if(f_Rx_NETWORK_JOIN_COMPLETE_03)
   {
      //Serial.println(F("Rx_NETWORK_JOIN_COMPLETE_03"));
     f_Rx_NETWORK_JOIN_COMPLETE_03 = false; // clear the message flag when it is used.
     WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal if the connection is aborted.
     Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
     *_WHAT_network_light = WHAT_NETWORK_CREATED;
     //Setup_WHAT_Show_Connection();
   }
    // If an abort message is recieved, return to the beginning.
    if(f_Rx_NETWORK_JOIN_ABORT_03) 
    {
        //Serial.println(F("Rx_NETWORK_JOIN_ABORT_03"));
      f_Rx_NETWORK_JOIN_ABORT_03 = false; // clear the message flag when it is used.
      WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal if the connection is aborted.
     Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
      *_WHAT_network_light = WHAT_NETWORK_NONE;
    }
} // End Loop monitor

 // *****************
// TOC Individual Recieve messages
void Rx_NETWORK_ALERT_PREEMIE_03 (WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
  //Serial.println(F("Rx_NETWORK_ALERT_PREEMIE_03"));
  f_Rx_NETWORK_ALERT_PREEMIE_03 = true;   // Notice from another device that a preemie is trying to join
  gbl_preemie_alert_seen = true;
  gbl_preemie_alert_expire = millis() + PREEMIE_ALERT_HOLD_MS;
}

// ***************** 
// TOC Individual Recieve messages
void Rx_NETWORK_ALLOW_PREEMIE_04(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{ // This will change the preemee state to WHAT_PRE_NETWORK_ALLOW_PREEMIE_04
  //Serial.print(F("Rx_NETWORK_ALLOW_PREEMIE_04: PANID:0x"));Serial.println(_WHAT_Rx_Packet.pan_id,HEX);
// Rx Message flags
  if(gbl_preemie_alert_seen && (gbl_preemie_alert_expire > millis()))
  {
    f_Rx_NETWORK_ALLOW_PREEMIE_04 = true;   // Notice to this preemie that it may accept its parent.
    _Offered_PANID = _WHAT_Rx_Packet.pan_id;
    myPANID = _WHAT_Rx_Packet.pan_id; // Make the panID of the accepting network into my own.
    Mrf24j_set_pan(myPANID);          // Set the PANID to the offered network to filter messages once allowed to join.
    _WaitForResponses = millis() + _RQST_ACK_DELAY;
  }
  else
  {
    f_Rx_NETWORK_ALLOW_PREEMIE_04 = false; // ignore stray allow without prior alert
  }
}

// *****************
// TOC Individual Recieve messages
void Rx_CHOOSE_NETWORK_05(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
  f_Rx_CHOOSE_NETWORK_05  = true;         // Notice to other networks that a network has accepted this preemie
  _Offered_PANID = _WHAT_Rx_Packet.payload[_index + 3] * 0x100 + _WHAT_Rx_Packet.payload[_index + 4];
  *_WHAT_network_light = WHAT_NETWORK_NONE; // return to normal light operation.
}

// *****************
// TOC Individual Recieve messages
// WHAT_Reusable_Message1
void Rx_PROPOSE_CHILD_NUMBER_05(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{ //This device received a proposed child address.
  // If this device has been accepted to a network, keep the lowest numbered proposal.
  f_Rx_PROPOSE_CHILD_NUMBER_05 = true;    // Preemie asking the network for a child number
  //Serial.println(F("Rx_PROPOSE_CHILD_NUMBER_05"));
    if (((_WHAT_Rx_Packet.payload[_index + 3] * 0x100) + (_WHAT_Rx_Packet.payload[_index + 4])) < _Offered_SourceAddress)
    { // Keep the lowest offered child address.
      //_Offered_PANID = _WHAT_Rx_Packet.pan_id;  //Only accepting PANID from the PANID that sent the allowance indication.
      _Offered_SourceAddress = ((_WHAT_Rx_Packet.payload[_index + 3] * 0x100) + _WHAT_Rx_Packet.payload[_index + 4]);
      //_Offered_Latchkey = ((_WHAT_Rx_Packet.payload[_index + 5] * 0x100) + _WHAT_Rx_Packet.payload[_index + 6]);
      _Offered_Parent = WHAT_Rx_Packet.sourceaddress;
      *_WHAT_network_light = (*_WHAT_network_light== WHAT_NETWORK_CREATING_ON)? WHAT_NETWORK_CREATING_OFF:WHAT_NETWORK_CREATING_ON; //   // This will toggle for each parent offering an address.
      //Serial.print(F("New offered ID: 0x")); Serial.println(_Offered_SourceAddress);
    }
}
// *****************
// TOC Individual Recieve messages
void Rx_NETWORK_JOIN_COMPLETE_03(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
  //Serial.println(F("Rx_Network    Join Complete"));
// Rx Message flags
  f_Rx_NETWORK_JOIN_COMPLETE_03 = true;   // Preeemie accepted a proposed parent 
}

// *****************
// TOC Individual Recieve messages
void Rx_ACCEPT_PARENT_08(WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{
  if(WHAT_preemie_state == WHAT_NEW_CHILD_ALLOWED)
  { // This state is ONLY valid if THIS device has already offered a child address.         
    //#define ACCEPT_PARENT_08         0xF006 // 1 byte length, 2 byte command, 2 byte parent, 2 byte latchkey, 1 byte relation type // preemie accepts offer from parent, and confirms latchkey and security key
       
      if((_Offered_SourceAddress == _WHAT_Rx_Packet.sourceaddress) & (mySourceAddress == _WHAT_Rx_Packet.destination))
      { // the desired address matches.  this device will be added as a child.
        f_Rx_ACCEPT_PARENT_08 = true;       // While a new network is forming, requests existing network to claim its PANID
        uint8_t _myChild_available_Index = 0;
        // Locate the desired address slot.

        // Verify the child address matches an open child slot:
        //The algorithn is a little confusing.  Offered child addresses use the address of this device with the child index as the next higher nibble.
        // This requires pulling out the address of THIS device (Parent), and rotating the recieved address so only the index remains.
        // This can be done with rotation.
        //    So "If mySourceAddress == 0x0000, then myChildIndex must not move (meaning the proposed address is 0x000C) (where C is the child index)
        //       "If mySourceAddress >0x0000, then myChildIndex must move right 1 nibble (rotate right 4 times)(meaning the proposed address is 0x00Cp) (where C is the child index, and p is the parent address)
        //       "If mySourceAddress >0x000F, then myChildIndex must move left 2 nibbles (rotate right 8 times)(meaning the proposed address is 0x0C0p) (where C is the child index, and p is the parent address)
        //       "If mySourceAddress >0x00FF, then myChildIndex must move left 3 nibbles (rotate right 12 times)(meaning the proposed address is 0xC00p) (where C is the child index, and p is the parent address)
        // At the end of this process, rotate the recieved source address to the least significant nibble location.
        _myChild_available_Index = _WHAT_Rx_Packet.sourceaddress >> ( ((mySourceAddress > 0x0) * 4) + ((mySourceAddress > 0x0F) * 4) + ((mySourceAddress > 0x0FF) * 4) );
        
        //and make sure that index does not already have a child in it, then fill it with this child.... 
        if(myChildren[_myChild_available_Index].ChildAddress == 0xFFFF)
        {
          myChildren[_myChild_available_Index].ChildAddress = _WHAT_Rx_Packet.sourceaddress;
          myChildren[_myChild_available_Index].LatchKeyValue = ((_WHAT_Rx_Packet.payload[_index+4]*0x100) +_WHAT_Rx_Packet.payload[_index+5]);
          myChildren[_myChild_available_Index].RelationshipType = _WHAT_Rx_Packet.payload[_index+6];
          Serial.print(F("Child accepted.  Index:"));Serial.println(_myChild_available_Index);
          Serial.println(F("PANID\tMyChild\tmyLatchkey\tmyRelationship"));
          Serial.print(myPANID,HEX);Serial.print(F("\t"));Serial.print(myChildren[_myChild_available_Index].ChildAddress,HEX);Serial.print(F("\t"));Serial.print(myChildren[_myChild_available_Index].LatchKeyValue,HEX);Serial.print(F("\t"));Serial.println(myChildren[_myChild_available_Index].RelationshipType,HEX);
        }
        else
        {
          //Serial.println(F("Child slot was taken..."));
        }
      }

    WHAT_preemie_state = WHAT_PREEMIE_FINISHED; // Return to normal operating state.
     Network_held = millis()+ NETWORK_HELD_DELAY; // Reset the network held timer
    WHAT_StoreEEPROM();
    Setup_WHAT_Show_Connection();
    *_WHAT_network_light = WHAT_NETWORK_NONE; // return to normal light operation.
  }
}

// *****************
// TOC Individual Transmit messages
void Tx_PROPOSE_CHILD_NUMBER_05 (void)
{
  WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
  _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
  // In addition to proposing a child, tell the entire network that a child is trying to join:
  _WHAT_Tx_Packet.pan_id = myPANID;
  _WHAT_Tx_Packet.destination = 0xFFFF;   // Send this to all devices.
  _WHAT_Tx_Packet.sourceaddress = mySourceAddress;  // Use the source ddress of this device.
  uint8_t _index = 0;
  _WHAT_Tx_Packet.payload[_index++] = 5; //Total payload length (including this byte)
  _WHAT_Tx_Packet.payload[_index++] = 4; //MID length (including this byte)
  _WHAT_Tx_Packet.payload[_index++] = highByte(NETWORK_ALLOW_PREEMIE_04);
  _WHAT_Tx_Packet.payload[_index++] = lowByte(NETWORK_ALLOW_PREEMIE_04);
  _WHAT_Tx_Packet.payload[_index++] = 0x01;  // Confirm is part of the allow network. (deny to be added elsewhere)
  WHAT_preemie_state = WHAT_NEW_CHILD_REQ; // Change the mode of this device to look for a joining device.

  // further MID will not be sent if this device does not have any available child slots.
  uint8_t _myChild_available_Index = 0;
  uint8_t _i = 1;
  while((_i < 16) & (_myChild_available_Index ==0))
  {
    // Check each index. If the source address is available (0xFFFF), capture that index, and stop the loop.
    if( myChildren[_i].ChildAddress < 0xFFFF) {_i++;}else{_myChild_available_Index = _i;}
    //Serial.print("Address/_i");Serial.print(myChildren[_i].ChildAddress);Serial.println(_i);
  }
  
  if ((_myChild_available_Index >0) & (_myChild_available_Index < 16)) //if the index is 16, then no slots available.  Address 0 is indistinguishable from parent, and is not allowed.
  {
    // Child slot is available.

    // Create a proposed child address.  This will be the lowest available address.
    //The child address will be in the next higher nibble of the parent's address.
    //Each generation (above the master) will use the next higher nibble, and the open child index.
    //Also note that only 4 generations will fit in a 2 byte number.

    //The algorithn is a little confusing, but if mySourceAddress < 0xF, then the child index must be rotated 1 nibble to the left.
    // This could be done with rotation, but multiplying by 0x0010 serves the same purpose.
    //    So "If mySourceAddress == 0x0000, then myChildIndex must not move (making the proposed address 0x000C) (where C is the child index)
    //       "If mySourceAddress >0x0000, then myChildIndex must move left 1 nibble (rotate left 4 times)(making the proposed address 0x00C0) (where C is the child index)
    //       "If mySourceAddress >0x000F, then myChildIndex must move left 2 nibbles (rotate left 8 times)(making the proposed address 0x0C00) (where C is the child index)
    //       "If mySourceAddress >0x00FF, then myChildIndex must move left 3 nibbles (rotate left 12 times)(making the proposed address 0xC000) (where C is the child index)
    //        At the end of this process, mySourceAddress is logic ORed with myChildIndex becoming the _proposed_child_address.
    //        ** device addresses above 0x3FFF are not allowed.  If this index results in a larger number, it will not offer an address.
    _Offered_SourceAddress = (_myChild_available_Index) << ( ((mySourceAddress > 0x0) * 4) + ((mySourceAddress > 0x0F) * 4) + ((mySourceAddress > 0x0FF) * 4) );
    //Serial.print("Calc child address "); Serial.println(_proposed_child_address,HEX);
    _Offered_SourceAddress |= mySourceAddress; // This incorporates the parent address into the child's address.
    // *******  NOTE:  This _Offered_SourceAddress is checked when recieving ACCEPT_PARENT_08 *********** // 
    //Serial.print("mySource"); Serial.println(mySourceAddress,HEX);
    //Serial.print("_proposed_child_address:0x"); Serial.println(_proposed_child_address,HEX);

    if (_Offered_SourceAddress < 0x4FFF)
    {
      // A valid child address is available.
      _WHAT_Tx_Packet.payload[0] = 10; //Change this to include the length of the proposed child address.
      _WHAT_Tx_Packet.payload[_index++] = 5;   //MID size (for the 2nd message).
      _WHAT_Tx_Packet.payload[_index++] = highByte(PROPOSE_CHILD_NUMBER_05);// 1 byte length, 2 byte command, 2 byte child address, 2 byte latchkey // Any device that has open child slots replies to request (REQUEST_JOIN_NETWORK_02).
      _WHAT_Tx_Packet.payload[_index++] = lowByte(PROPOSE_CHILD_NUMBER_05); //in order to support multibyte MIDs, put the high byte first.
      _WHAT_Tx_Packet.payload[_index++] = highByte(_Offered_SourceAddress);//in order to support multibyte MIDs, put the high byte first.
      _WHAT_Tx_Packet.payload[_index++] = lowByte(_Offered_SourceAddress);
      //Serial.print(F("Tx Propose child address @")); Serial.println(_Offered_SourceAddress,HEX);
      WHATRxMessage[WHAT_Reusable_Message1].MessageID = ACCEPT_PARENT_08;  // these are prospective parents offering free addresses.
      WHATRxMessage[WHAT_Reusable_Message1].callback = &Rx_ACCEPT_PARENT_08; // Message callback set here to collect the responses
    }//End if my address proposal will be vaild.
  }// End If I have an available child slot
  WHAT_TransmitPacket(_WHAT_Tx_Packet);
}

// *****************
// TOC Individual Recieve messages
void Rx_ABANDON_CHILD_05 (WHAT_Packet _WHAT_Rx_Packet, uint8_t _index)
{  // One of this device's children is leaving it.
   // Clear the child information from the index.
   // Moving all the other children would also require giving them new addresses, which 
   // is unnecessary, so this slot will remain open.  New devices can re-use this address.
   uint8_t _i=0;
   while (_i<=ChildMaxIndex)
   {
      if(_WHAT_Rx_Packet.sourceaddress == myChildren[_i].ChildAddress)
      { // the child has been found.  Before blanking, make sure it really was this child by checking the latchkey value.
        if(((_WHAT_Rx_Packet.payload[_index + 3] * 0x100) + _WHAT_Rx_Packet.payload[_index + 4]) == myChildren[_i].LatchKeyValue)
        { // This is the child.  Remove it from the index.
            myChildren[_i].ChildAddress = 0xFFFF;
            myChildren[_i].LatchKeyValue = 0xFFFF;
            myChildren[_i].RelationshipType = 0;
            myChildren[_i].Security = 0xFFFF;
        }//End Child removed
        else
        {// Security breach... incorrect latchkey value.  Note the security breach (not yet implimented)
          WHAT_Packet _WHAT_Tx_Packet;  // Make a temporary transmit packet
          _WHAT_Tx_Packet.WHAT_MAC_MESSAGE;
          _WHAT_Tx_Packet.pan_id = myPANID;
          _WHAT_Tx_Packet.destination = 0xFFFF;   // Send this to all devices.
          _WHAT_Tx_Packet.sourceaddress = mySourceAddress;  // Use the source ddress of this device.
          uint8_t _index = 0;
          _WHAT_Tx_Packet.payload[_index++] = 5; //Total payload length (including this byte)
          _WHAT_Tx_Packet.payload[_index++] = 4; //MID length (including this byte)
          _WHAT_Tx_Packet.payload[_index++] = highByte(Security_Breach_04);
          _WHAT_Tx_Packet.payload[_index++] = lowByte(Security_Breach_04);
          _WHAT_Tx_Packet.payload[_index++] = SB_BUMP;  //(bump)   A parent sees a request to abandon child, but the latchkey value is incorrect.
              WHAT_TransmitPacket(_WHAT_Tx_Packet);
        }// End security breach
       _i = ChildMaxIndex + 1;   // discontinue the search once the child is found by making the index greater than the highest index.
      }// End if child match found.
    _i++; //Check the next entry.
   }// End while looking for child entry.
}

